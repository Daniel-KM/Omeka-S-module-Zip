#: data/scripts/upgrade.php:33 Module.php:67
#, php-format
msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr "Le module %1$s doit être mis à niveau à la version %2$s ou ultérieure."

#: data/scripts/upgrade.php:37 data/scripts/upgrade.php:57
#: data/scripts/upgrade.php:79
msgid "Missing requirement. Unable to upgrade."
msgstr "Pré-requis absent. Impossible de mettre à jour."

#: data/scripts/upgrade.php:44
msgid "It is now possible to store resources separately with files."
msgstr ""
"Il est désormais possible de stocker des ressources séparément avec des "
"fichiers."

#: data/scripts/upgrade.php:53 data/scripts/upgrade.php:75 Module.php:81
#: Module.php:89 src/Job/ZipFiles.php:58
msgid "The directory \"{directory}\" is not writeable."
msgstr "Le répertoire « {directory} » n’est pas accessible en écriture."

#: data/scripts/upgrade.php:61
msgid "It is now possible to store zip by item."
msgstr "Il est désormais possible de stocker le zip par contenu."

#: data/scripts/upgrade.php:133
msgid "Some zip files cannot be moved to the directory \"{directory}\": {list}"
msgstr ""
"Certains fichiers zip ne peuvent pas être déplacés dans le répertoire "
"« {directory} » : {list}"

#: data/scripts/upgrade.php:140
msgid ""
"The zip files are now stored in the protected directory \"{directory}\", "
"because they may contain private files."
msgstr ""
"Les fichiers zip sont désormais stockés dans le répertoire protégé "
"« {directory} », car ils peuvent contenir des fichiers privés."

#: Module.php:145
msgid ""
"Another job is running for the same process (job {link_job}#{job_id}"
"{link_end}, {link_log}logs{link_end})."
msgstr ""
"Une autre tâche est en cours pour le même traitement (tâche {link_job}"
"#{job_id}{link_end} ({link_log}journaux{link_end})."

#: Module.php:175 src/Job/ZipFiles.php:80
msgid "No zip to create."
msgstr "Aucun zip à créer."

#: Module.php:195
msgid ""
"Creating zips in background (job {link_job}#{job_id}{link_end}, {link_log}"
"logs{link_end})."
msgstr ""
"Création de zips en arrière-plan (tâche {link_job}#{job_id}{link_end}, "
"{link_log}journaux{link_end})."

#: Module.php:253
msgid "Zip: Store items and files as zip"
msgstr "Zip : Stocker des éléments et des fichiers sous forme de fichiers zip"

#: Module.php:259
msgid "Zip: Prepare zips of items and files"
msgstr "Zip : Préparation des zips des contenus et des fichiers"

#: Module.php:260
msgid "Store items and their files as zip archives."
msgstr "Stocker les contenus et fichiers en archives zip."

#: Module.php:262
msgid "Store"
msgstr "Stockage"

#: src/Job/ZipFiles.php:69
msgid "The php extension \"zip\" is required to create the archives."
msgstr "L'extension php « zip » est nécessaire pour créer les archives."

#: src/Job/ZipFiles.php:87
msgid "Zipping files by items ({format})."
msgstr "Compression des fichiers par contenu ({format})."

#: src/Job/ZipFiles.php:92
msgid ""
"Zipping \"{format}\" files by item ended: {total} files created in folder "
"{directory}."
msgstr ""
"Compression des fichiers « {format} » par contenu terminée : {total} "
"fichiers créés dans le dossier {directory}."

#: src/Job/ZipFiles.php:99
msgid "Zipping \"{format}\" files by {count}."
msgstr "Compression des fichiers « {format} » par {count}."

#: src/Job/ZipFiles.php:104
msgid ""
"Zipping \"{format}\" files by {count} ended: {total} files created in folder "
"{directory}."
msgstr ""
"Compression des fichiers « {format} » par {count} terminée : {total} "
"fichiers créés dans le dossier {directory}."

#: src/Job/ZipFiles.php:112
msgid "Added zip list in {file}."
msgstr "Ajout de la liste des zip dans {file}."

#: src/Job/ZipFiles.php:118
msgid "Zipping ended."
msgstr "Fin de la compression."

#: src/Job/ZipFiles.php:156
msgid "Unable to collect items with digital objects: {message}"
msgstr ""
"Impossible de récupérer les contenus avec des objets numériques : {message}"

#: src/Job/ZipFiles.php:170
msgid "The file path {directory} is not a directory."
msgstr "Le chemin d’accès {directory} n’est pas un dossier."

#: src/Job/ZipFiles.php:179
msgid "The directory {directory} for zip items cannot be created."
msgstr ""
"Le dossier « {directory} » pour les zip des contenus ne peut pas être créé."

#: src/Job/ZipFiles.php:187
msgid "The directory {directory} for zip items is not writeable."
msgstr ""
"Le dossier « {directory} » pour compresser les contenus n’est pas "
"inscriptible."

#: src/Job/ZipFiles.php:212
msgid "Zipping \"{format}\" files by item stopped at {count}/{total}."
msgstr ""
"Compression des fichiers « {format} » par contenu arrêtée à {count}/{total}."

#: src/Job/ZipFiles.php:263
msgid ""
"For item #{item_id}, {count} \"{format}\" files are missing: #{media_ids}"
msgstr ""
"Pour le contenu #{item_id}, il manque des fichiers {count} « {format} » : "
"#{media_ids}"

#: src/Job/ZipFiles.php:357
msgid "Zipping \"{format}\" files stopped."
msgstr "Compression des fichiers au format \"{format}\" arrêtée."

#: src/Form/SettingsFieldset.php:11
msgid "Zip resources"
msgstr "Zip ressources"

#: src/Form/SettingsFieldset.php:14
msgid "Zip"
msgstr "Zip"

#: src/Form/SettingsFieldset.php:28
msgid "Create a zip by item for derivatives"
msgstr "Créer un zip par contenu pour les fichiers dérivés"

#: src/Form/SettingsFieldset.php:32
msgid "Large"
msgstr "Large"

#: src/Form/SettingsFieldset.php:34
msgid "Square"
msgstr "Carré"

#: src/Form/SettingsFieldset.php:46
msgid "Include digital objects referenced by item in the per-item zip"
msgstr ""
"Inclure les objets numériques référencés par contenu dans leur archive zip"

#: src/Form/SettingsFieldset.php:47
msgid ""
"When enabled and the module DigitalObject is active, digital objects linked "
"to an item via property values are added to the item zip."
msgstr ""
"Si activée avec le module DigitalObject, les objets numériques liés à un "
"contenu via des valeurs de propriété sont ajoutés au fichier zip du contenu."

#: src/Form/SettingsFieldset.php:58
msgid "Create a zip for original files: Number of files by zip"
msgstr "Créer un zip pour les fichiers originaux : nombre de fichiers par zip"

#: src/Form/SettingsFieldset.php:70
msgid "Create a zip for large files: Number of files by zip"
msgstr ""
"Créez un fichier zip pour les fichiers volumineux : Nombre de fichiers par "
"zip"

#: src/Form/SettingsFieldset.php:82
msgid "Create a zip for medium files: Number of files by zip"
msgstr ""
"Créer un zip pour les fichiers de taille moyenne : Nombre de fichiers par zip"

#: src/Form/SettingsFieldset.php:94
msgid "Create a zip for square files: Number of files by zip"
msgstr "Créer un zip pour les fichiers carrés : Nombre de fichiers par zip"

#: src/Form/SettingsFieldset.php:106
msgid "Create a zip for asset files: Number of files by zip"
msgstr ""
"Créer un fichier zip pour les fichiers de type « asset » : Nombre de "
"fichiers par zip"

#: src/Form/SettingsFieldset.php:118
msgid "Add file \"zipfiles.txt\" with the list of zip files"
msgstr "Ajout du fichier « zipfiles.txt » avec la liste des fichiers zip"

#: src/Form/SettingsFieldset.php:129
msgid "Run background task to create zip files (or use EasyAdmin)"
msgstr ""
"Exécuter une tâche en arrière-plan pour créer des fichiers zip (ou utiliser "
"EasyAdmin)"

