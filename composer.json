{
    "name": "daniel-km/omeka-s-module-zip",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Create zip of resources (record + media files) that the visitor can download, and zip of files directories for backup purpose.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "download",
        "backup"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-Zip",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-Zip/-/work_items",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "require": {
        "ext-zip": "*"
    },
    "autoload": {
        "psr-4": {
            "Zip\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZipTest\\": "tests/ZipTest/"
        }
    },
    "extra": {
        "installer-name": "Zip"
    }
}
